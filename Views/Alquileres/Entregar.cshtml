@model IEnumerable<CategoriaVehiculo>

@{
    ViewData["Title"] = "Entregar Vehículo";
}

<h1>Entregar vehículo</h1>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-action="Entregar" method="post" class="mt-4">
    <div class="d-flex justify-content-center justify-items-center">
        <div class="card mb-3 w-25">
            <div class="card-header">1. Categoría</div>
            <div class="card-body row g-3">
                <div class="col-md-4 w-100">
                    <label for="categoriaId" class="form-label">Elegir categoría</label>
                    <select id="categoriaId" class="form-select">
                        @foreach (var categoria in Model)
                        {
                            <option value="@categoria.Id">@categoria.Nombre</option>
                        }
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-center">
        <div class="card mb-3 w-25">
            <div class="card-header">2. Vehículo</div>
            <div class="card-body">
                <label for="alquilerId" class="form-label">Elegir vehículo reservado</label>
                <select id="alquilerId" name="alquilerId" class="form-select"></select>
                <div id="sinReservas" class="form-text text-danger d-none">
                    No se ha encontrado vehículos reservados y operativos
                </div>
            </div>
        </div>
    </div>

    <div id="panelReserva" class="d-flex justify-content-center d-none">
        <div class="card mb-3 w-50">
            <div class="card-header">3. Datos de la reserva</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Cliente</dt>
                    <dd class="col-sm-7" id="dCliente"></dd>
                    <dt class="col-sm-5">DNI</dt>
                    <dd class="col-sm-7" id="dDNI"></dd>
                    <dt class="col-sm-5">Vehículo</dt>
                    <dd class="col-sm-7" id="dVehiculo"></dd>
                    <dt class="col-sm-5">Kilometraje actual</dt>
                    <dd class="col-sm-7" id="dKilometraje"></dd>
                    <dt class="col-sm-5">Entrega prevista</dt>
                    <dd class="col-sm-7" id="dEntrega"></dd>
                    <dt class="col-sm-5">Devolución prevista</dt>
                    <dd class="col-sm-7" id="dDevolucion"></dd>
                    <dt class="col-sm-5">Precio acordado</dt>
                    <dd class="col-sm-7" id="dPrecio"></dd>
                </dl>
            </div>
        </div>
    </div>

    <button type="submit" id="btnConfirmar" class="btn btn-success">Confirmar entrega</button>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</form>

@section Scripts {
    <script>
        const selCategoria = document.getElementById("categoriaId");
        const selVehiculo  = document.getElementById("alquilerId");
        const panel = document.getElementById("panelReserva");
        const sinReservas  = document.getElementById("sinReservas");

        async function cargarVehiculos() {
            selVehiculo.innerHTML = "";
            panel.classList.add("d-none");

            const resp = await fetch(`/Alquileres/ReservadosPorCategoria?categoriaId=${selCategoria.value}`);
            const datos = await resp.json();

            sinReservas.classList.toggle("d-none", datos.length > 0);
            if (datos.length === 0) return;

            selVehiculo.add(new Option("-- Seleccionar --", ""));
            datos.forEach(d => selVehiculo.add(new Option(d.texto, d.alquilerId)));
        }

        async function cargarDetalle() {
            if (!selVehiculo.value) {
                panel.classList.add("d-none");
                return;
            }

            const resp = await fetch(`/Alquileres/DetalleReserva?alquilerId=${selVehiculo.value}`);
            if (!resp.ok) {
                panel.classList.add("d-none");
                return;
            }
            const d = await resp.json();

            document.getElementById("dCliente").textContent = d.cliente;
            document.getElementById("dDNI").textContent = d.dni;
            document.getElementById("dVehiculo").textContent = d.vehiculo;
            document.getElementById("dKilometraje").textContent = `${d.kilometraje} km`;
            document.getElementById("dEntrega").textContent = d.entregaPrevista;
            document.getElementById("dDevolucion").textContent = d.devolucionPrevista;
            document.getElementById("dPrecio").textContent = `${d.precioAcordado}$`;

            panel.classList.remove("d-none");
        }

        selCategoria.addEventListener("change", cargarVehiculos);
        selVehiculo.addEventListener("change", cargarDetalle);

        cargarVehiculos();
    </script>
}