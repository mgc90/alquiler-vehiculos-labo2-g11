@{
    ViewData["Title"] = "Alquileres";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Alquileres</h1>
    <div class="d-flex justify-content-end gap-3">
        <a asp-action="NuevaReserva" class="btn btn-primary">Nueva reserva</a>
        <a asp-action="Entregar" class="btn btn-success">Entregar vehiculo</a>
        <a asp-action="Devolver" class="btn btn-solid theme-info">Devolver vehiculo</a>
    </div>
</div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success">@mensaje</div>
}
