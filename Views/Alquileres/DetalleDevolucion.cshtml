@using alquiler_vehiculos_g11.Models.Enums
@model Alquiler

@{
    ViewData["Title"] = "Detalle de la devolución";

    var ar = new System.Globalization.CultureInfo("es-AR");
    string Peso(decimal n) => n.ToString("C", ar);

    var pagado = Model.PagosVigentes;
    var totalExigible = Model.TotalExigible;
    var saldo = Model.SaldoPendiente;

    var esAnticipada = Model.EsCancelacionPosteriorAlRetiro;
    var diasContratados = CalculoImportesAlquiler.DiasContratados(
        Model.EntregaPrevista,
        Model.DevolucionPrevista);

    var diasUso = Model.EntregaReal.HasValue && Model.DevolucionReal.HasValue
        ? CalculoImportesAlquiler.DiasUso(
            Model.EntregaReal.Value,
            Model.DevolucionReal.Value)
        : diasContratados;

    var diasRestantes = Math.Max(0, diasContratados - diasUso);
    var porcentaje = CalculoImportesAlquiler.PorcentajeMultaDiasRestantes(
        diasContratados,
        diasUso);

    var importeUso = Model.ImporteUsoEfectivo;
    var multaCancelacion = Model.MultaCancelacion;
    var otrosCargos = Model.OtrosCargos;

    var diasDemora = 0;
    if (!esAnticipada && Model.DevolucionReal.HasValue)
    {
        diasDemora = CalculoImportesAlquiler.DiasDemora(
            Model.DevolucionPrevista,
            Model.DevolucionReal.Value);
    }
}

<h1>Detalle de la devolución</h1>

<div class="alert alert-success">
    Devolución registrada correctamente. Estado del alquiler: <strong>@Model.Estado</strong>.
</div>

@if (esAnticipada)
{
    <div class="alert alert-warning">
        La devolución fue anticipada: se cobró el uso efectivo de @diasUso día(s)
        y una multa del @((porcentaje * 100).ToString("0")) % sobre los @diasRestantes día(s) restantes.
        El importe original del alquiler se conserva solo como referencia y no se cobra completo.
    </div>
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header">Alquiler N.º @Model.Id</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Cliente</dt>
                    <dd class="col-sm-7">@Model.Cliente?.Apellido, @Model.Cliente?.Nombre</dd>
                    <dt class="col-sm-5">DNI</dt>
                    <dd class="col-sm-7">@Model.Cliente?.Dni</dd>
                    <dt class="col-sm-5">Vehículo</dt>
                    <dd class="col-sm-7">@Model.Vehiculo?.Marca @Model.Vehiculo?.Modelo (@Model.Vehiculo?.Patente)</dd>
                    <dt class="col-sm-5">Kilometraje actual</dt>
                    <dd class="col-sm-7">@Model.Vehiculo?.KilometrajeActual km</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header">Fechas</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-6">Entrega prevista</dt>
                    <dd class="col-sm-6">@Model.EntregaPrevista.ToString("dd/MM/yyyy")</dd>
                    <dt class="col-sm-6">Entrega real</dt>
                    <dd class="col-sm-6">@(Model.EntregaReal?.ToString("dd/MM/yyyy HH:mm") ?? "-")</dd>
                    <dt class="col-sm-6">Devolución prevista</dt>
                    <dd class="col-sm-6">@Model.DevolucionPrevista.ToString("dd/MM/yyyy")</dd>
                    <dt class="col-sm-6">Devolución real</dt>
                    <dd class="col-sm-6">@(Model.DevolucionReal?.ToString("dd/MM/yyyy HH:mm") ?? "-")</dd>

                    @if (esAnticipada)
                    {
                        <dt class="col-sm-6">Días de uso</dt>
                        <dd class="col-sm-6">@diasUso día/s (devolución anticipada)</dd>
                    }
                    else
                    {
                        <dt class="col-sm-6">Días de demora</dt>
                        <dd class="col-sm-6">@(diasDemora > 0 ? $"{diasDemora} día/s" : "Sin demora")</dd>
                    }
                </dl>
            </div>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card mb-3">
            <div class="card-header">Resumen del importe</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-8">Importe original del alquiler</dt>
                    <dd class="col-sm-4 text-end">@Peso(Model.ImporteTotal)</dd>

                    @if (esAnticipada)
                    {
                        <dt class="col-sm-8">
                            Importe de uso efectivo
                            <span>(@diasUso día/s × @Peso(Model.PrecioAcordado))</span>
                        </dt>
                        <dd class="col-sm-4 text-end">@Peso(importeUso)</dd>

                        <dt class="col-sm-8">
                            Multa por cancelación
                            <span>(@((porcentaje * 100).ToString("0")) % de @diasRestantes día/s restantes)</span>
                        </dt>
                        <dd class="col-sm-4 text-end">@Peso(multaCancelacion)</dd>
                    }

                    @if (otrosCargos > 0)
                    {
                        <dt class="col-sm-8">Otros cargos adicionales (demora / daños)</dt>
                        <dd class="col-sm-4 text-end">@Peso(otrosCargos)</dd>
                    }

                    <dt class="col-sm-8">Total exigible</dt>
                    <dd class="col-sm-4 text-end fw-bold">@Peso(totalExigible)</dd>

                    <dt class="col-sm-8">Pagos vigentes</dt>
                    <dd class="col-sm-4 text-end">@Peso(pagado)</dd>

                    <dt class="col-sm-8">Saldo pendiente</dt>
                    <dd class="col-sm-4 text-end fw-bold @(saldo > 0 ? "text-danger" : "text-success")">
                        @Peso(saldo)
                    </dd>
                </dl>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Observaciones))
        {
            <div class="card mb-3">
                <div class="card-header">Observaciones</div>
                <div class="card-body">@Model.Observaciones</div>
            </div>
        }

        <div class="d-flex gap-2">
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-primary">
                Ver alquiler
            </a>
            <a asp-action="Index" class="btn btn-secondary">Volver a alquileres</a>
            <a asp-action="Devolver" class="btn btn-outline-primary">Registrar otra devolución</a>
        </div>
    </div>
</div>
