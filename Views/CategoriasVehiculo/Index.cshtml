@model IEnumerable<alquiler_vehiculos_g11.Models.CategoriaVehiculo>

@{
    ViewData["Title"] = "Categorías de Vehículos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Categorías de Vehículos</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Nueva Categoría
    </a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Precio Diario</th>
                    <th>Depósito Garantía</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model) {
                <tr class="@(!item.Activa ? "table-secondary text-muted" : "")">
                    <td class="fw-bold">@item.Nombre</td>
                    <td>@(string.IsNullOrEmpty(item.Descripcion) ? "-" : item.Descripcion)</td>
                    <td>$@item.PrecioDiario.ToString("N2")</td>
                    <td>$@item.DepositoGarantia.ToString("N2")</td>
                    <td>
                        @if (item.Activa) {
                            <span class="badge bg-success">Activa</span>
                        } else {
                            <span class="badge bg-secondary">Inactiva</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Detalles</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Editar</a>
                        @if (item.Activa) {
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Desactivar</a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
