@model alquiler_vehiculos_g11.Models.CategoriaVehiculo

@{
    ViewData["Title"] = "Detalles de la Categoría";
}

<h2>Detalles de la Categoría</h2>
<hr />

<div class="card shadow-sm col-md-6">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Nombre</dt>
            <dd class="col-sm-8">@Model.Nombre</dd>

            <dt class="col-sm-4">Descripción</dt>
            <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Descripcion) ? "-" : Model.Descripcion)</dd>

            <dt class="col-sm-4">Precio Diario</dt>
            <dd class="col-sm-8">$@Model.PrecioDiario.ToString("N2")</dd>

            <dt class="col-sm-4">Depósito Garantía</dt>
            <dd class="col-sm-8">$@Model.DepositoGarantia.ToString("N2")</dd>

            <dt class="col-sm-4">Estado</dt>
            <dd class="col-sm-8">
                @if (Model.Activa) {
                    <span class="badge bg-success">Activa</span>
                } else {
                    <span class="badge bg-secondary">Inactiva</span>
                }
            </dd>
        </dl>
    </div>
    <div class="card-footer bg-light">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
        <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
    </div>
</div>
