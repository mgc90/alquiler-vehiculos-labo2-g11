@model alquiler_vehiculos_g11.Models.ViewModels.CategoriaVehiculoFormularioViewModel

@{
    ViewData["Title"] = "Editar Categoría";
}

<h2>Editar Categoría</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label"></label>
                <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PrecioDiario" class="form-label"></label>
                <input asp-for="PrecioDiario" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="PrecioDiario" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DepositoGarantia" class="form-label"></label>
                <input asp-for="DepositoGarantia" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="DepositoGarantia" class="text-danger"></span>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-warning">Actualizar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}