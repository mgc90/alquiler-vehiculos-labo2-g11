@model AuditoriaViewModel
@{
    ViewData["Title"] = "Auditoría";
    var paginasAlquileres = (int)Math.Ceiling(Model.Alquileres.TotalRegistros / (double)Model.Alquileres.TamanioPagina);
    var paginasPagos = (int)Math.Ceiling(Model.Pagos.TotalRegistros / (double)Model.Pagos.TamanioPagina);
}

<h1 class="mb-3">Auditoría</h1>

<form asp-action="Index" method="get" class="card card-body mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-8">
            <label for="usuarioId" class="form-label">Usuario</label>
            <select id="usuarioId" name="usuarioId" class="form-select">
                <option value="">Todos</option>
                @foreach (var usuario in Model.Usuarios)
                {
                    <option value="@usuario.Id" selected="@(Model.UsuarioId == usuario.Id)">
                        @usuario.Apellido, @usuario.Nombre (@usuario.Email)
                    </option>
                }
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Filtrar</button>
        </div>
    </div>
</form>

<h2 class="h4 mb-3">Alquileres</h2>
<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Alquiler</th>
                <th>Cliente</th>
                <th>Vehículo</th>
                <th>Creado por</th>
                <th>Cerrado por</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var alquiler in Model.Alquileres.Elementos)
            {
                <tr>
                    <td>#@alquiler.Id</td>
                    <td>@alquiler.Cliente?.Apellido, @alquiler.Cliente?.Nombre</td>
                    <td>@alquiler.Vehiculo?.Patente</td>
                    <td>@alquiler.CreadoPorUsuario?.Email</td>
                    <td>@alquiler.CerradoPorUsuario?.Email</td>
                    <td>@alquiler.Estado</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div class="d-flex flex-wrap align-items-center gap-2 mb-4">
    <span class="text-muted me-auto">@Model.Alquileres.TotalRegistros alquiler(es)</span>
    <nav aria-label="Paginación de alquileres auditados">
        <ul class="pagination pagination-sm mb-0">
            @if (Model.Alquileres.Pagina > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-usuarioId="@Model.UsuarioId"
                       asp-route-paginaAlquileres="@(Model.Alquileres.Pagina - 1)"
                       asp-route-paginaPagos="@Model.Pagos.Pagina">Anterior</a>
                </li>
            }
            <li class="page-item disabled" aria-current="page">
                <span class="page-link">Página @Model.Alquileres.Pagina de @Math.Max(1, paginasAlquileres)</span>
            </li>
            @if (Model.Alquileres.Pagina < paginasAlquileres)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-usuarioId="@Model.UsuarioId"
                       asp-route-paginaAlquileres="@(Model.Alquileres.Pagina + 1)"
                       asp-route-paginaPagos="@Model.Pagos.Pagina">Siguiente</a>
                </li>
            }
        </ul>
    </nav>
</div>

<h2 class="h4 mb-3">Pagos</h2>
<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Pago</th>
                <th>Alquiler</th>
                <th>Fecha</th>
                <th>Importe</th>
                <th>Tipo</th>
                <th>Estado</th>
                <th>Creado por</th>
                <th>Anulado por</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pago in Model.Pagos.Elementos)
            {
                <tr>
                    <td>#@pago.Id</td>
                    <td>#@pago.AlquilerId</td>
                    <td>@pago.Fecha.ToString("g")</td>
                    <td>@pago.Importe.ToString("C")</td>
                    <td>@pago.Tipo</td>
                    <td>@pago.Estado</td>
                    <td>@pago.CreadoPorUsuario?.Email</td>
                    <td>@pago.AnuladoPorUsuario?.Email</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div class="d-flex flex-wrap align-items-center gap-2">
    <span class="text-muted me-auto">@Model.Pagos.TotalRegistros pago(s)</span>
    <nav aria-label="Paginación de pagos auditados">
        <ul class="pagination pagination-sm mb-0">
            @if (Model.Pagos.Pagina > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-usuarioId="@Model.UsuarioId"
                       asp-route-paginaAlquileres="@Model.Alquileres.Pagina"
                       asp-route-paginaPagos="@(Model.Pagos.Pagina - 1)">Anterior</a>
                </li>
            }
            <li class="page-item disabled" aria-current="page">
                <span class="page-link">Página @Model.Pagos.Pagina de @Math.Max(1, paginasPagos)</span>
            </li>
            @if (Model.Pagos.Pagina < paginasPagos)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-usuarioId="@Model.UsuarioId"
                       asp-route-paginaAlquileres="@Model.Alquileres.Pagina"
                       asp-route-paginaPagos="@(Model.Pagos.Pagina + 1)">Siguiente</a>
                </li>
            }
        </ul>
    </nav>
</div>
