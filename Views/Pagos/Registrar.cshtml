@model alquiler_vehiculos_g11.Models.ViewModels.PagoFormularioViewModel
@using alquiler_vehiculos_g11.Models.Enums

@{
    ViewData["Title"] = "Registrar Pago";
}

<h2>Registrar Pago</h2>
<hr />
@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="alert alert-info">
    <div>
        Alquiler
        <a asp-controller="Alquileres" asp-action="Details"
           asp-route-id="@Model.AlquilerId">#@Model.AlquilerId</a>
        — Estado: <strong>@Model.EstadoAlquiler</strong>
    </div>
    <div>Importe original: <strong>@Model.ImporteOriginal.ToString("C2")</strong></div>
    @if (Model.Multa > 0)
    {
        <div>Cargos adicionales (multa / recargo / daños): <strong>@Model.Multa.ToString("C2")</strong></div>
    }
    <div>Total exigible: <strong>@Model.ImporteExigible.ToString("C2")</strong></div>
    <div>Saldo pendiente: <strong>@Model.SaldoPendiente.ToString("C2")</strong></div>
    @if (Model.CargosPendientes > 0)
    {
        <div>
            Cargos adicionales pendientes: <strong>@Model.CargosPendientes.ToString("C2")</strong>.
            @if (Model.CargosPendientes < Model.SaldoPendiente)
            {
                <span>
                    El importe del pago debe ser mayor o igual a ese total y no puede
                    superar el saldo pendiente de
                    <strong>@Model.SaldoPendiente.ToString("C2")</strong>.
                </span>
            }
            else
            {
                <span>El importe del pago debe ser exactamente ese total.</span>
            }
        </div>
    }
</div>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Registrar" method="post">
            <input type="hidden" asp-for="AlquilerId" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Importe" class="form-label">
                    Importe
                </label>
                <input asp-for="Importe" class="form-control" type="number" step="0.01" min="0.01" />
                <span asp-validation-for="Importe" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Tipo" class="form-label">
                    Tipo de pago
                </label>
                <select asp-for="Tipo" asp-items="Html.GetEnumSelectList<TipoPago>()" class="form-select">
                    <option value="">Seleccione un tipo de pago</option>
                </select>
                <span asp-validation-for="Tipo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MedioPago" class="form-label">
                    Medio de pago
                </label>
                <select asp-for="MedioPago" class="form-select">
                    <option value="">Seleccione un medio de pago</option>
                    <option value="Efectivo">Efectivo</option>
                    <option value="Transferencia">Transferencia</option>
                </select>
                <span asp-validation-for="MedioPago" class="text-danger"></span>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">
                    Registrar pago
                </button>
                <a asp-controller="Alquileres" asp-action="Details" asp-route-id="@Model.AlquilerId"
                    class="btn btn-secondary">
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
