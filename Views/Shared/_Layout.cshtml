@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    var usuarioActual = User.Identity?.IsAuthenticated == true ? await UserManager.GetUserAsync(User) : null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Alquiler de vehículos</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/alquiler_vehiculos_g11.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">Alquiler de vehículos</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-navigation"
                        aria-controls="main-navigation" aria-expanded="false" aria-label="Mostrar navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="main-navigation">
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Clientes" asp-action="Index">Clientes</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Alquileres" asp-action="Index">Alquileres</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Pagos" asp-action="Index">Pagos</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Imagenes" asp-action="Index">Imágenes</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Informes" asp-action="Index">Informes</a></li>
                            @if (User.IsInRole("Administrador"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="CategoriasVehiculo" asp-action="Index">Categorías</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Vehiculos" asp-action="Index">Vehículos</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Usuarios" asp-action="Index">Usuarios</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Auditoria" asp-action="Index">Auditoría</a></li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav ms-auto">
                        @if (usuarioActual is not null)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Perfil" asp-action="Index">@usuarioActual.Nombre @usuarioActual.Apellido</a></li>
                            <li class="nav-item">
                                <form asp-controller="Acceso" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-link nav-link">Salir</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Acceso" asp-action="Login">Ingresar</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top footer text-muted">
        <div class="container">&copy; 2026 - Sistema de gestión de alquiler de vehículos</div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
