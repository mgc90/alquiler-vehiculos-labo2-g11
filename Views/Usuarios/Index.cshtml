@model ResultadoPaginado<UsuarioListaViewModel>
@{
    ViewData["Title"] = "Usuarios";

    var totalPaginas = Math.Max(
        1,
        (int)Math.Ceiling(Model.TotalRegistros / (double)Model.TamanioPagina));
}

<h1>Usuarios</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Nuevo usuario</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Apellido y nombre</th>
            <th>Email</th>
            <th>Rol</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var usuario in Model.Elementos)
        {
            <tr>
                <td>@usuario.Apellido, @usuario.Nombre</td>
                <td>@usuario.Email</td>
                <td>@usuario.Rol</td>
                <td>@(usuario.Activo ? "Activo" : "Inactivo")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@usuario.Id">Detalle</a> |
                    <a asp-action="Edit" asp-route-id="@usuario.Id">Editar</a>
                    @if (usuario.Activo)
                    {
                        <text> | </text>
                        <a asp-action="Delete" asp-route-id="@usuario.Id">Dar de baja</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="d-flex align-items-center gap-2">
    @if (Model.Pagina > 1)
    {
        <a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-pagina="@(Model.Pagina - 1)">Anterior</a>
    }

    <span>Página @Model.Pagina de @totalPaginas — @Model.TotalRegistros usuario(s)</span>

    @if (Model.Pagina < totalPaginas)
    {
        <a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-pagina="@(Model.Pagina + 1)">Siguiente</a>
    }
</div>
