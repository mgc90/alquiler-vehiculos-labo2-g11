@model ResultadoPaginado<UsuarioListaViewModel>
@{
    ViewData["Title"] = "Usuarios";

    var totalPaginas = Math.Max(
        1,
        (int)Math.Ceiling(Model.TotalRegistros / (double)Model.TamanioPagina));
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="mb-0">Usuarios</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo usuario</a>
</div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Apellido y nombre</th>
                    <th>Email</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var usuario in Model.Elementos)
                {
                    <tr>
                        <td>@usuario.Apellido, @usuario.Nombre</td>
                        <td>@usuario.Email</td>
                        <td>@usuario.Rol</td>
                        <td>
                            <span class="badge @(usuario.Activo ? "bg-success" : "bg-secondary")">
                                @(usuario.Activo ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@usuario.Id" class="btn btn-sm btn-outline-info">Detalle</a>
                            <a asp-action="Edit" asp-route-id="@usuario.Id" class="btn btn-sm btn-outline-warning">Editar</a>
                            @if (usuario.Activo)
                            {
                                <a asp-action="Delete" asp-route-id="@usuario.Id" class="btn btn-sm btn-outline-danger">Dar de baja</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

<nav aria-label="Paginación de usuarios">
    <ul class="pagination justify-content-center">
        <li class="page-item @(Model.Pagina <= 1 ? "disabled" : string.Empty)">
            <a class="page-link" asp-action="Index" asp-route-pagina="@(Model.Pagina - 1)">Anterior</a>
        </li>

        <li class="page-item disabled">
            <span class="page-link">
                Página @Model.Pagina de @totalPaginas
                (@Model.TotalRegistros usuarios)
            </span>
        </li>

        <li class="page-item @(Model.Pagina >= totalPaginas ? "disabled" : string.Empty)">
            <a class="page-link" asp-action="Index" asp-route-pagina="@(Model.Pagina + 1)">Siguiente</a>
        </li>
    </ul>
</nav>
