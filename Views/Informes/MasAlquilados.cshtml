@model InformeMasAlquiladosViewModel
@{
    ViewData["Title"] = "Vehículos más alquilados";
    var totalPaginas = (int)Math.Ceiling(Model.Resultado.TotalRegistros / (double)Model.Resultado.TamanioPagina);
}

<h1>Vehículos más alquilados en los últimos 365 días</h1>
<table class="table">
    <thead><tr><th>Patente</th><th>Marca</th><th>Modelo</th><th>Categoría</th><th>Alquileres</th></tr></thead>
    <tbody>
        @foreach (var item in Model.Resultado.Elementos)
        {
            <tr>
                <td>@item.Vehiculo.Patente</td>
                <td>@item.Vehiculo.Marca</td>
                <td>@item.Vehiculo.Modelo</td>
                <td>@item.Vehiculo.CategoriaVehiculo?.Nombre</td>
                <td>@item.CantidadAlquileres</td>
            </tr>
        }
    </tbody>
</table>
<p>@Model.Resultado.TotalRegistros vehículo(s)</p>
@if (Model.Resultado.Pagina > 1)
{
    <a asp-action="MasAlquilados" asp-route-pagina="@(Model.Resultado.Pagina - 1)">Anterior</a>
}
<span>Página @Model.Resultado.Pagina de @Math.Max(1, totalPaginas)</span>
@if (Model.Resultado.Pagina < totalPaginas)
{
    <a asp-action="MasAlquilados" asp-route-pagina="@(Model.Resultado.Pagina + 1)">Siguiente</a>
}
