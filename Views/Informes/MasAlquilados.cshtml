@model InformeMasAlquiladosViewModel
@{
    ViewData["Title"] = "Vehículos más alquilados";
    var totalPaginas = (int)Math.Ceiling(Model.Resultado.TotalRegistros / (double)Model.Resultado.TamanioPagina);
}

<h1 class="mb-3">Vehículos más alquilados en los últimos 365 días</h1>
<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light"><tr><th>Patente</th><th>Marca</th><th>Modelo</th><th>Categoría</th><th>Alquileres</th></tr></thead>
        <tbody>
            @foreach (var item in Model.Resultado.Elementos)
            {
                <tr>
                    <td>@item.Vehiculo.Patente</td>
                    <td>@item.Vehiculo.Marca</td>
                    <td>@item.Vehiculo.Modelo</td>
                    <td>@item.Vehiculo.CategoriaVehiculo?.Nombre</td>
                    <td>@item.CantidadAlquileres</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div class="d-flex flex-wrap align-items-center gap-2">
    <span class="text-muted me-auto">@Model.Resultado.TotalRegistros vehículo(s)</span>
    <nav aria-label="Paginación de vehículos más alquilados">
        <ul class="pagination pagination-sm mb-0">
            @if (Model.Resultado.Pagina > 1)
            {
                <li class="page-item"><a class="page-link" asp-action="MasAlquilados" asp-route-pagina="@(Model.Resultado.Pagina - 1)">Anterior</a></li>
            }
            <li class="page-item disabled" aria-current="page"><span class="page-link">Página @Model.Resultado.Pagina de @Math.Max(1, totalPaginas)</span></li>
            @if (Model.Resultado.Pagina < totalPaginas)
            {
                <li class="page-item"><a class="page-link" asp-action="MasAlquilados" asp-route-pagina="@(Model.Resultado.Pagina + 1)">Siguiente</a></li>
            }
        </ul>
    </nav>
</div>
