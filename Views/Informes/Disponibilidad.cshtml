@model InformeDisponibilidadViewModel
@{
    ViewData["Title"] = "Disponibilidad de vehículos";
    var totalPaginas = Model.Resultado is null
        ? 0
        : (int)Math.Ceiling(Model.Resultado.TotalRegistros / (double)Model.Resultado.TamanioPagina);
}

<h1>Disponibilidad de vehículos</h1>

<form asp-action="Disponibilidad" method="get">
    <label for="entregaPrevista">Entrega prevista</label>
    <input id="entregaPrevista" name="entregaPrevista" type="date"
           value="@Model.EntregaPrevista?.ToString("yyyy-MM-dd")" />

    <label for="devolucionPrevista">Devolución prevista</label>
    <input id="devolucionPrevista" name="devolucionPrevista" type="date"
           value="@Model.DevolucionPrevista?.ToString("yyyy-MM-dd")" />

    <label for="categoriaVehiculoId">Categoría (opcional)</label>
    <select id="categoriaVehiculoId" name="categoriaVehiculoId">
        <option value="">Todas las categorías</option>
        @foreach (var categoria in Model.Categorias)
        {
            <option value="@categoria.Id" selected="@(Model.CategoriaVehiculoId == categoria.Id)">
                @categoria.Nombre
            </option>
        }
    </select>
    <button type="submit">Buscar</button>
</form>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <p class="text-danger">@Model.Error</p>
}

@if (Model.Resultado is not null)
{
    <table class="table">
        <thead>
            <tr>
                <th>Patente</th>
                <th>Marca</th>
                <th>Modelo</th>
                <th>Categoría</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var vehiculo in Model.Resultado.Elementos)
            {
                <tr>
                    <td>@vehiculo.Patente</td>
                    <td>@vehiculo.Marca</td>
                    <td>@vehiculo.Modelo</td>
                    <td>@vehiculo.CategoriaVehiculo?.Nombre</td>
                </tr>
            }
        </tbody>
    </table>

    <p>@Model.Resultado.TotalRegistros vehículo(s) disponible(s)</p>
    @if (Model.Resultado.Pagina > 1)
    {
        <a asp-action="Disponibilidad"
           asp-route-entregaPrevista="@Model.EntregaPrevista?.ToString("yyyy-MM-dd")"
           asp-route-devolucionPrevista="@Model.DevolucionPrevista?.ToString("yyyy-MM-dd")"
           asp-route-categoriaVehiculoId="@Model.CategoriaVehiculoId"
           asp-route-pagina="@(Model.Resultado.Pagina - 1)">Anterior</a>
    }
    <span>Página @Model.Resultado.Pagina de @Math.Max(1, totalPaginas)</span>
    @if (Model.Resultado.Pagina < totalPaginas)
    {
        <a asp-action="Disponibilidad"
           asp-route-entregaPrevista="@Model.EntregaPrevista?.ToString("yyyy-MM-dd")"
           asp-route-devolucionPrevista="@Model.DevolucionPrevista?.ToString("yyyy-MM-dd")"
           asp-route-categoriaVehiculoId="@Model.CategoriaVehiculoId"
           asp-route-pagina="@(Model.Resultado.Pagina + 1)">Siguiente</a>
    }
}
