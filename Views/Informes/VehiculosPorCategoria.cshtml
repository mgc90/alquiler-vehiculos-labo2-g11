@model InformeVehiculosCategoriaViewModel
@{
    ViewData["Title"] = "Vehículos por categoría";
    var totalPaginas = (int)Math.Ceiling(Model.Resultado.TotalRegistros / (double)Model.Resultado.TamanioPagina);
}

<h1 class="mb-3">Vehículos por categoría</h1>
<form asp-action="VehiculosPorCategoria" method="get" class="card card-body mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-6">
            <label for="categoriaVehiculoId" class="form-label">Categoría</label>
            <select id="categoriaVehiculoId" name="categoriaVehiculoId" class="form-select">
                <option value="">Todas las categorías</option>
                @foreach (var categoria in Model.Categorias)
                {
                    <option value="@categoria.Id" selected="@(Model.CategoriaVehiculoId == categoria.Id)">
                        @categoria.Nombre
                    </option>
                }
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Buscar</button>
        </div>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light"><tr><th>Patente</th><th>Marca</th><th>Modelo</th><th>Categoría</th></tr></thead>
        <tbody>
            @foreach (var vehiculo in Model.Resultado.Elementos)
            {
                <tr>
                    <td>@vehiculo.Patente</td>
                    <td>@vehiculo.Marca</td>
                    <td>@vehiculo.Modelo</td>
                    <td>@vehiculo.CategoriaVehiculo?.Nombre</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div class="d-flex flex-wrap align-items-center gap-2">
    <span class="text-muted me-auto">@Model.Resultado.TotalRegistros vehículo(s)</span>
    <nav aria-label="Paginación de vehículos por categoría">
        <ul class="pagination pagination-sm mb-0">
            @if (Model.Resultado.Pagina > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="VehiculosPorCategoria" asp-route-categoriaVehiculoId="@Model.CategoriaVehiculoId"
                       asp-route-pagina="@(Model.Resultado.Pagina - 1)">Anterior</a>
                </li>
            }
            <li class="page-item disabled" aria-current="page">
                <span class="page-link">Página @Model.Resultado.Pagina de @Math.Max(1, totalPaginas)</span>
            </li>
            @if (Model.Resultado.Pagina < totalPaginas)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="VehiculosPorCategoria" asp-route-categoriaVehiculoId="@Model.CategoriaVehiculoId"
                       asp-route-pagina="@(Model.Resultado.Pagina + 1)">Siguiente</a>
                </li>
            }
        </ul>
    </nav>
</div>
