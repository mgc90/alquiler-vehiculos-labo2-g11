@model InformeQueFinalizanViewModel
@{
    ViewData["Title"] = "Alquileres próximos a finalizar";
    var totalPaginas = Model.Resultado is null
        ? 0
        : (int)Math.Ceiling(Model.Resultado.TotalRegistros / (double)Model.Resultado.TamanioPagina);
}

<h1 class="mb-3">Alquileres próximos a finalizar</h1>
<form asp-action="QueFinalizan" method="get" class="card card-body mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-6">
            <label for="dias" class="form-label">Dentro de cuántos días</label>
            <input id="dias" name="dias" type="number" min="1" max="3650" class="form-control" value="@Model.Dias" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Buscar</button>
        </div>
    </div>
</form>
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger" role="alert">@Model.Error</div>
}
@if (Model.Resultado is not null)
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-light"><tr><th>Cliente</th><th>Vehículo</th><th>Devolución prevista</th><th>Estado</th></tr></thead>
            <tbody>
                @foreach (var alquiler in Model.Resultado.Elementos)
                {
                    <tr>
                        <td>@alquiler.Cliente?.Apellido, @alquiler.Cliente?.Nombre</td>
                        <td>@alquiler.Vehiculo?.Patente</td>
                        <td>@alquiler.DevolucionPrevista.ToString("d")</td>
                        <td>@alquiler.Estado</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
        <span class="text-muted me-auto">@Model.Resultado.TotalRegistros alquiler(es)</span>
        <nav aria-label="Paginación de alquileres próximos a finalizar">
            <ul class="pagination pagination-sm mb-0">
                @if (Model.Resultado.Pagina > 1)
                {
                    <li class="page-item"><a class="page-link" asp-action="QueFinalizan" asp-route-dias="@Model.Dias" asp-route-pagina="@(Model.Resultado.Pagina - 1)">Anterior</a></li>
                }
                <li class="page-item disabled" aria-current="page"><span class="page-link">Página @Model.Resultado.Pagina de @Math.Max(1, totalPaginas)</span></li>
                @if (Model.Resultado.Pagina < totalPaginas)
                {
                    <li class="page-item"><a class="page-link" asp-action="QueFinalizan" asp-route-dias="@Model.Dias" asp-route-pagina="@(Model.Resultado.Pagina + 1)">Siguiente</a></li>
                }
            </ul>
        </nav>
    </div>
}
