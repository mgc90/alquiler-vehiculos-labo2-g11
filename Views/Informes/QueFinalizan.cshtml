@model InformeQueFinalizanViewModel
@{
    ViewData["Title"] = "Alquileres próximos a finalizar";
    var totalPaginas = Model.Resultado is null
        ? 0
        : (int)Math.Ceiling(Model.Resultado.TotalRegistros / (double)Model.Resultado.TamanioPagina);
}

<h1>Alquileres próximos a finalizar</h1>
<form asp-action="QueFinalizan" method="get">
    <label for="dias">Dentro de cuántos días</label>
    <input id="dias" name="dias" type="number" min="1" max="3650" value="@Model.Dias" />
    <button type="submit">Buscar</button>
</form>
@if (!string.IsNullOrEmpty(Model.Error))
{
    <p class="text-danger">@Model.Error</p>
}
@if (Model.Resultado is not null)
{
    <table class="table">
        <thead><tr><th>Cliente</th><th>Vehículo</th><th>Devolución prevista</th><th>Estado</th></tr></thead>
        <tbody>
            @foreach (var alquiler in Model.Resultado.Elementos)
            {
                <tr>
                    <td>@alquiler.Cliente?.Apellido, @alquiler.Cliente?.Nombre</td>
                    <td>@alquiler.Vehiculo?.Patente</td>
                    <td>@alquiler.DevolucionPrevista.ToString("d")</td>
                    <td>@alquiler.Estado</td>
                </tr>
            }
        </tbody>
    </table>
    <p>@Model.Resultado.TotalRegistros alquiler(es)</p>
    @if (Model.Resultado.Pagina > 1)
    {
        <a asp-action="QueFinalizan" asp-route-dias="@Model.Dias"
           asp-route-pagina="@(Model.Resultado.Pagina - 1)">Anterior</a>
    }
    <span>Página @Model.Resultado.Pagina de @Math.Max(1, totalPaginas)</span>
    @if (Model.Resultado.Pagina < totalPaginas)
    {
        <a asp-action="QueFinalizan" asp-route-dias="@Model.Dias"
           asp-route-pagina="@(Model.Resultado.Pagina + 1)">Siguiente</a>
    }
}
