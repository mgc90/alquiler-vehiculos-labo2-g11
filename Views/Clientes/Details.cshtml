@model Cliente
@{
    ViewData["Title"] = "Detalles del cliente";
}

<h1>Detalles del cliente</h1>

<div>
    <dl class="row">
        <dt class="col-sm-3">Dni</dt>
        <dd class="col-sm-9">@Model.Dni</dd>

        <dt class="col-sm-3">Nombre</dt>
        <dd class="col-sm-9">@Model.Nombre</dd>

        <dt class="col-sm-3">Apellido</dt>
        <dd class="col-sm-9">@Model.Apellido</dd>

        <dt class="col-sm-3">Fecha de Nacimiento</dt>
        <dd class="col-sm-9">@Model.FechaNacimiento</dd>

        <dt class="col-sm-3">Telefono</dt>
        <dd class="col-sm-9">@Model.Telefono</dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>

        <dt class="col-sm-3">Numero de la Licencia</dt>
        <dd class="col-sm-9">@Model.NumeroLicencia</dd>

        <dt class="col-sm-3">Fecha de Vencimiento de la Licencia</dt>
        <dd class="col-sm-9">@Model.VencimientoLicencia</dd>

        <dt class="col-sm-3">Estado</dt>
        <dd class="col-sm-9">@(Model.Activo ? "Activo" : "Inactivo")</dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>
