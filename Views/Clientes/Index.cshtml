@model ResultadoPaginado<Cliente>
@{
    ViewData["Title"] = "Clientes";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="mb-0">Clientes</h1>
    <a asp-action="Create" class="btn btn-primary">Crear cliente</a>
</div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Apellido y nombre</th>
                    <th>DNI</th>
                    <th>Fecha de nacimiento</th>
                    <th>Teléfono</th>
                    <th>Email</th>
                    <th>Número de licencia</th>
                    <th>Vencimiento de licencia</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Cliente cliente in Model.Elementos)
                {
                    <tr>
                        <td>@cliente.Apellido, @cliente.Nombre</td>
                        <td>@cliente.Dni</td>
                        <td>@cliente.FechaNacimiento.ToString("d")</td>
                        <td>@cliente.Telefono</td>
                        <td>@cliente.Email</td>
                        <td>@cliente.NumeroLicencia</td>
                        <td>@cliente.VencimientoLicencia.ToString("d")</td>
                        <td>
                            <span class="badge @(cliente.Activo ? "bg-success" : "bg-secondary")">
                                @(cliente.Activo ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@cliente.Id" class="btn btn-sm btn-outline-info">Detalle</a>
                            <a asp-action="Edit" asp-route-id="@cliente.Id" class="btn btn-sm btn-outline-warning">Editar</a>
                            @if (cliente.Activo)
                            {
                                <a asp-action="Delete" asp-route-id="@cliente.Id" class="btn btn-sm btn-outline-danger">Dar de baja</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

@{
    var totalPaginas = Math.Max(
        1,
        (int)Math.Ceiling(
            Model.TotalRegistros / (double)Model.TamanioPagina));
    var paginaActual = Model.Pagina;
}

<nav aria-label="Paginación de clientes">
    <ul class="pagination justify-content-center">
        <li class="page-item @(paginaActual <= 1 ? "disabled" : string.Empty)">
            <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual - 1)">Anterior</a>
        </li>

        <li class="page-item disabled">
            <span class="page-link">
                Página @paginaActual de @totalPaginas
                (@Model.TotalRegistros registros)
            </span>
        </li>

        <li class="page-item @(paginaActual >= totalPaginas ? "disabled" : string.Empty)">
            <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual + 1)">Siguiente</a>
        </li>
    </ul>
</nav>
